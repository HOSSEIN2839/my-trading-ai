# Never commit your real .env file
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
SYMBOL=BTC/USDT
TIMEFRAME=15m
CANDLE_LIMIT=250
POLL_SECONDS=60
MODE=paper
INITIAL_BALANCE=1000
RISK_PER_TRADE=0.005
MAX_DAILY_LOSS=0.02
MAX_POSITION_FRACTION=0.25
ATR_STOP_MULTIPLIER=2.0
REWARD_RISK=2.0
TAKER_FEE=0.001
# Optional local state paths for the paper broker and memory
PAPER_STATE_PATH=data/paper_state.json
PAPER_TRADES_PATH=data/trades.csv
MEMORY_DB_PATH=data/memory.sqlite3
DASHBOARD_PORT=8765
